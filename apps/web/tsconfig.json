{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "bun"],
    "paths": {
      "@/*": ["./src/*"],
      "#state-backend": ["./src/state/baseline.ts"]
    }
  },
  "include": ["src", "scripts", "vite.config.ts"],
  "references": [{ "path": "./tsconfig.omp-vendor.json" }],
  "exclude": [
    "src/features/omp/vendor/omp-render",
    "src/pwa/sw.ts",
    "src/state/statelib.ts",
    "src/state/statelib-scope.ts",
    "src/state/statelib-scope.test.ts"
  ]
}
