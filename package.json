{
  "name": "hsw-editor",
  "version": "0.1.4",
  "private": true,
  "description": "Local 3D wall editor for HSW honeycomb tool walls: photo to wall, offline PWA, omp agent panel.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @hsw-editor/web dev",
    "dev:server": "bun --watch apps/server/src/index.ts",
    "build": "bun scripts/tools/demo-assets.ts && bun run --filter @hsw-editor/web build",
    "typecheck": "bun scripts/typecheck.ts",
    "vendor:omp-render": "bun scripts/vendor-omp-render.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test packages apps scripts",
    "setup:state-lib": "bun scripts/setup-state-lib.ts",
    "bank:build-variant": "bun scripts/bank/build-variant.ts",
    "bank:ingest": "bun scripts/bank/ingest.ts",
    "bank:verify": "bun scripts/bank/verify.ts",
    "bank:adopt": "bun scripts/bank/adopt.ts",
    "bank:schema": "bun scripts/bank/schema.ts",
    "check": "bun run lint && bun run typecheck && bun scripts/bank/schema.ts --check && bun scripts/bank/verify.ts --seed && bun run test && bun run build",
    "release": "bun scripts/release.ts",
    "pwa:assets": "bun scripts/gen-pwa-assets.ts",
    "tools:sheet": "bun packages/tools/scripts/sheet.ts",
    "tools:prototypes": "bun packages/tools/scripts/prototypes.ts",
    "bench:invalid-zones": "bun apps/web/scripts/bench-invalid-zones.ts",
    "tools:demo-assets": "bun scripts/tools/demo-assets.ts --force"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "1.4.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
