{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grid": {
      "type": "object",
      "properties": {
        "colPitchMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rowPitchMm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": ["colPitchMm", "rowPitchMm"],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "fromSources": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "generated": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "redistributable": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": ["total", "fromSources", "generated", "redistributable"],
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*)?$"
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*)?$"
          },
          "name": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["ru", "en"],
            "additionalProperties": false
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": ["id", "name", "order"],
        "additionalProperties": false
      }
    },
    "toolClasses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["ru", "en"],
            "additionalProperties": false
          },
          "synonyms": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "en": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["ru", "en"],
            "additionalProperties": false
          }
        },
        "required": ["id", "name", "synonyms"],
        "additionalProperties": false
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["ru", "en"],
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["ru", "en"],
            "additionalProperties": false
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*)?$"
          },
          "tags": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "en": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["ru", "en"],
            "additionalProperties": false
          },
          "toolClasses": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "fitsTool": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "toolClass": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "dims": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": ["min", "max"],
                    "additionalProperties": false
                  }
                },
                "capacity": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "notes": {
                  "type": "object",
                  "properties": {
                    "ru": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["ru", "en"],
                  "additionalProperties": false
                }
              },
              "required": ["toolClass"],
              "additionalProperties": false
            }
          },
          "footprint": {
            "type": "object",
            "properties": {
              "cells": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dCol": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "dRow2": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["dCol", "dRow2"],
                  "additionalProperties": false
                }
              },
              "cols": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["cells", "cols", "rows"],
            "additionalProperties": false
          },
          "bboxMm": {
            "type": "object",
            "properties": {
              "min": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": ["x", "y", "z"],
                "additionalProperties": false
              },
              "max": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": ["x", "y", "z"],
                "additionalProperties": false
              }
            },
            "required": ["min", "max"],
            "additionalProperties": false
          },
          "dimsMm": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": ["x", "y", "z"],
            "additionalProperties": false
          },
          "mounting": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["hex-plug", "m3-screw", "clip", "none"]
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dCol": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "dRow2": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["dCol", "dRow2"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["kind", "cells"],
            "additionalProperties": false
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                },
                "label": {
                  "type": "object",
                  "properties": {
                    "ru": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["ru", "en"],
                  "additionalProperties": false
                },
                "unit": {
                  "type": "string",
                  "enum": ["mm", "count", "deg"]
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "default": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": ["key", "label", "unit", "min", "max", "default", "step"],
              "additionalProperties": false
            }
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "variantLabel": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["ru", "en"],
            "additionalProperties": false
          },
          "generated": {
            "type": "boolean"
          },
          "assets": {
            "type": "object",
            "properties": {
              "lod0": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?:glb|thumb|variant)\\/[0-9a-f]{16}\\.(?:glb|webp)$"
                  },
                  "bytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": ["path", "bytes", "sha256"],
                "additionalProperties": false
              },
              "lod1": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?:glb|thumb|variant)\\/[0-9a-f]{16}\\.(?:glb|webp)$"
                  },
                  "bytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": ["path", "bytes", "sha256"],
                "additionalProperties": false
              },
              "thumbnail": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?:glb|thumb|variant)\\/[0-9a-f]{16}\\.(?:glb|webp)$"
                  },
                  "bytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": ["path", "bytes", "sha256"],
                "additionalProperties": false
              },
              "triangles": {
                "type": "object",
                "properties": {
                  "lod0": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "lod1": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["lod0", "lod1"],
                "additionalProperties": false
              }
            },
            "required": ["lod0", "lod1", "thumbnail", "triangles"],
            "additionalProperties": false
          },
          "printNotes": {
            "type": "object",
            "properties": {
              "materials": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "orientation": {
                "type": "object",
                "properties": {
                  "ru": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["ru", "en"],
                "additionalProperties": false
              },
              "supports": {
                "type": "boolean"
              },
              "notes": {
                "type": "object",
                "properties": {
                  "ru": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["ru", "en"],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "enum": ["source-file", "project-original", "generated"]
              },
              "source": {
                "type": "object",
                "properties": {
                  "site": {
                    "type": "string",
                    "enum": ["printables", "makerworld", "thingiverse", "hsw-project", "unknown"]
                  },
                  "modelId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "author": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "file": {
                    "type": "string"
                  },
                  "partId": {
                    "type": "string"
                  },
                  "sourceSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": ["site", "file", "sourceSha256"],
                "additionalProperties": false
              },
              "generator": {
                "type": "object",
                "properties": {
                  "generator": {
                    "type": "string"
                  },
                  "part": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "values": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                },
                "required": ["generator", "part", "version", "values"],
                "additionalProperties": false
              },
              "orientation": {
                "type": "string",
                "enum": ["curated", "auto", "generator"]
              },
              "geometryHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "duplicates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["origin", "orientation", "geometryHash", "duplicates"],
            "additionalProperties": false
          },
          "license": {
            "type": "object",
            "properties": {
              "spdx": {
                "type": "string",
                "enum": [
                  "MIT",
                  "CC-BY-4.0",
                  "CC-BY-NC-4.0",
                  "CC-BY-NC-SA-4.0",
                  "LicenseRef-Standard-Digital-File",
                  "LicenseRef-Unknown"
                ]
              },
              "observed": {
                "type": "string"
              },
              "attribution": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "redistributable": {
                "type": "boolean"
              }
            },
            "required": ["spdx", "observed", "attribution", "redistributable"],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "tags",
          "toolClasses",
          "fitsTool",
          "footprint",
          "bboxMm",
          "dimsMm",
          "mounting",
          "generated",
          "assets",
          "provenance",
          "license"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "contentHash", "grid", "counts", "categories", "toolClasses", "elements"],
  "additionalProperties": false
}
